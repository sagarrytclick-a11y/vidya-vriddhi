generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum ExamType {
  NATIONAL
  STATE
  UNIVERSITY
  INTERNATIONAL
}

enum ExamMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum Frequency {
  ONCE_A_YEAR
  TWICE_A_YEAR
  QUARTERLY
  MONTHLY
}

enum EnquiryStatus {
  PENDING
  RESOLVED
  FOLLOW_UP
}

// --- Independent / Base Models ---

model Country {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  flagEmoji   String?
  description String?
  active      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cities      City[]
  colleges    College[]

  @@index([active])
  @@index([createdAt])
}

model Category {
  id               String    @id @default(cuid())
  name             String    @unique
  slug             String    @unique
  description      String?
  active           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  categoryImageUrl String?
  colleges         College[] @relation("CategoryToCollege")

  @@index([active])
  @@index([createdAt])
}

model Course {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  active      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  colleges    College[] @relation("CollegeToCourse")

  @@index([active])
  @@index([createdAt])
}

model News {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  imageUrl  String?

  @@index([active])
  @@index([createdAt])
  @@index([title])
}

model Blog {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  imageUrl  String?

  @@index([active])
  @@index([createdAt])
  @@index([title])
}

model Enquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  city      String?
  category  String?
  status    EnquiryStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([name])
  @@index([phone])
  @@index([city])
}

/// Leads from /services popup (website / social / leads enquiry)
model ServiceEnquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String
  status    EnquiryStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([name])
  @@index([phone])
}

model CareerApplication {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String
  position     String
  /// ImageKit file path (private) or legacy public URL
  resumeUrl    String
  resumeFileId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
  @@index([email])
  @@index([position])
  @@index([name])
}

model City {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  description  String?
  cityImageURL String?
  features     String[]  @default([])
  active       Boolean   @default(false)
  countryId    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  country      Country   @relation(fields: [countryId], references: [id])
  colleges     College[]

  @@index([countryId])
  @@index([active])
  @@index([createdAt])
  @@index([active, createdAt])
  @@index([slug])
  @@index([name])
}

model Exam {
  id               String    @id @default(cuid())
  name             String    @unique
  slug             String    @unique
  shortName        String
  description      String
  active           Boolean   @default(false)
  conductingBody   String
  frequency        Frequency
  examMode         ExamMode
  examType         ExamType
  examImageurl     String?
  examPattern      Json?
  examDates        Json?
  overview         Json?
  registration     Json?
  resultStatistics Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  colleges         College[] @relation("CollegeToExam")

  @@index([examType])
  @@index([examMode])
  @@index([active])
  @@index([createdAt])
  @@index([active, createdAt])
  @@index([slug])
  @@index([name])
}

model College {
  id                   String     @id @default(cuid())
  name                 String     @unique
  slug                 String     @unique
  description          String?
  establishment_year   Int?
  Countryranking       String?
  Internationalranking String?
  active               Boolean    @default(false)
  features             String[]   @default([])
  logoURL              String?
  imageURL             String?
  keyHighlights        Json?
  whyChooseUs          Json?
  documentsRequired    Json?
  feesStructure        Json?
  admissionProcess     Json?
  campusHighlights     Json?
  countryId            String
  cityId               String
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  city                 City       @relation(fields: [cityId], references: [id])
  country              Country    @relation(fields: [countryId], references: [id])
  categories           Category[] @relation("CategoryToCollege")
  courses              Course[]   @relation("CollegeToCourse")
  exams                Exam[]     @relation("CollegeToExam")

  @@index([countryId])
  @@index([cityId])
  @@index([active])
  @@index([Countryranking])
  @@index([createdAt])
  @@index([active, createdAt])
  @@index([slug])
  @@index([name])
}

/// Staff accounts created from Admin UI (env ADMIN_USERNAME remains bootstrap superadmin)
model AdminStaff {
  id             String   @id @default(cuid())
  username       String   @unique
  passwordHash   String
  /// admin | content_writer (superadmin stays env-only)
  role           String
  active         Boolean  @default(true)
  /// Bumped on password change / deactivate — invalidates old cookies
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([username])
  @@index([active])
}

/// Shared rate-limit buckets (works across all Vercel instances — free Neon)
model RateLimitBucket {
  id        String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

/// Logged-out / revoked admin tokens until natural expiry
model AdminTokenDeny {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
